KUBECTL ?= kubectl

BASE64_DECODE ?= $(shell (echo Zg== | base64 -D >/dev/null 2>&1 && echo "base64 -D") || echo "base64 -d")

# Shared versions, namespaces and hostnames for all Makefiles.
# Adjust these values to customize component versions and base domain.

# Argo Workflows: Chart 1.0.14 -> App 4.0.5
ARGO_WORKFLOWS_NAMESPACE ?= argo
ARGO_WORKFLOWS_CHART_VERSION ?= 1.0.14
# Argo CLI version usually matches the App version
ARGO_CLI_VERSION ?= 4.0.5

# Argo CD: Chart 9.4.17 -> App 3.3.6
ARGO_CD_NAMESPACE ?= argocd
ARGO_CD_CHART_VERSION ?= 9.4.17

# Argo Events: Chart 2.4.20 -> App 1.9.10
ARGO_EVENTS_NAMESPACE ?= argo-events
ARGO_EVENTS_CHART_VERSION ?= 2.4.20

# kpack: 0.17.1
KPACK_NAMESPACE ?= kpack
KPACK_VERSION ?= 0.17.1

# kp CLI: 0.13.1
KP_CLI_VERSION ?= 0.13.1

# pack CLI: 0.39.1
PACK_CLI_VERSION ?= 0.39.1

# Helm CLI: 4.0.5
HELM_CLI_VERSION ?= 4.0.5

# Kubectl CLI: 1.35.0
KUBECTL_CLI_VERSION ?= 1.35.0

# Envoy Gateway: Chart version matches App version (1.7.1)
ENVOY_GATEWAY_NAMESPACE ?= envoy-gateway-system
ENVOY_GATEWAY_CHART_VERSION ?= 1.7.1

# Cert Manager: Chart version matches App version (1.20.1)
CERT_MANAGER_NAMESPACE ?= cert-manager
CERT_MANAGER_CHART_VERSION ?= 1.20.1

LETSENCRYPT_EMAIL ?= ci@metasync.cc

# Kubernetes Replicator: Chart version matches App version (2.12.3)
KUBERNETES_REPLICATOR_NAMESPACE ?= kubernetes-replicator
KUBERNETES_REPLICATOR_CHART_VERSION ?= 2.12.3

# Metrics Server: Chart 3.13.0 -> App 0.8.0
METRICS_SERVER_NAMESPACE ?= metrics-server
METRICS_SERVER_RELEASE_NAME ?= metrics-server
METRICS_SERVER_CHART_VERSION ?= 3.13.0

# StarRocks: Operator Chart 1.11.4 -> App 3.5
STARROCKS_NAMESPACE ?= starrocks
STARROCKS_CHART_VERSION ?= 1.11.4

# MinIO: Chart 5.4.0 -> Image RELEASE.2025-10-15T17-29-55Z
MINIO_NAMESPACE ?= minio
MINIO_RELEASE_NAME ?= minio
MINIO_CHART_VERSION ?= 5.4.0
MINIO_IMAGE_REPOSITORY ?= minio/minio
MINIO_IMAGE_TAG ?= RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE_REPOSITORY ?= minio/mc
MINIO_MC_IMAGE_TAG ?= RELEASE.2025-08-13T08-35-41Z

# Harbor: Chart 1.18.3 -> App 2.14.3
HARBOR_NAMESPACE ?= harbor
HARBOR_CHART_VERSION ?= 1.18.3

# JupyterHub: Chart 4.3.3 -> App 5.4.4
JUPYTERHUB_NAMESPACE ?= jupyterhub
JUPYTERHUB_CHART_VERSION ?= 4.3.3

# Keycloak: Operator/App 26.4.5
KEYCLOAK_NAMESPACE ?= keycloak
KEYCLOAK_OPERATOR_VERSION ?= 26.4.5
KEYCLOAK_VERSION ?= 26.4.5
KEYCLOAK_IMAGE ?= quay.io/keycloak/keycloak:$(KEYCLOAK_VERSION)
KEYCLOAK_CR_NAME ?= keycloak
KEYCLOAK_SERVICE_NAME ?= $(KEYCLOAK_CR_NAME)-service
KEYCLOAK_ADMIN_SECRET_NAME ?= keycloak-bootstrap-admin
KEYCLOAK_ADMIN_USERNAME ?= admin
KEYCLOAK_ADMIN_SECRET_KEY ?= password
KEYCLOAK_DB_SECRET_NAME ?= keycloak-db
KEYCLOAK_DB_SERVICE_NAME ?= postgres-db
KEYCLOAK_DB_NAME ?= keycloak
KEYCLOAK_DB_USERNAME ?= keycloak
KEYCLOAK_DB_PORT ?= 5432
KEYCLOAK_DB_IMAGE ?= postgres:17
KEYCLOAK_DB_STORAGE_SIZE ?= 2Gi
KEYCLOAK_REALM_IMPORT_TIMEOUT ?= 15m

# Elastic Stack (via ECK Operator)
ELASTIC_SYSTEM_NAMESPACE ?= elastic-system
ELASTIC_STACK_NAMESPACE ?= elastic-stack
ECK_OPERATOR_CHART_VERSION ?= 3.3.2
ELASTIC_STACK_VERSION ?= 8.12.2

FLEET_SERVER_NAME ?= fleet-server
ELASTIC_AGENT_NAME ?= elastic-agent
FLEET_SERVER_POLICY_ID ?= eck-fleet-server
ELASTIC_AGENT_POLICY_ID ?= eck-agent
FLEET_DATA_NAMESPACE ?= default
KIBANA_ENCRYPTION_SECRET_NAME ?= kibana-encryption-keys
APM_FLEET_SERVICE_NAME ?= apm

GATEWAY_NAMESPACE ?= gateway

# Hostnames for Web UIs
# Note: These defaults are for local development.
# Public URLs use *.$(LUBAN_PUBLIC_DOMAIN)
K8S_DOMAIN ?= luban.k8s.orb.local
LUBAN_PUBLIC_DOMAIN ?= luban.metasync.cc
APPS_DOMAIN ?= apps.k8s.orb.local
APPS_PUBLIC_DOMAIN ?= apps.metasync.cc
ARGO_WORKFLOWS_HOST ?= argo-workflows.$(K8S_DOMAIN)
ARGO_WORKFLOWS_PUBLIC_HOST ?= argo-workflows.$(LUBAN_PUBLIC_DOMAIN)
ARGO_CD_HOST ?= argocd.$(K8S_DOMAIN)
ARGO_CD_PUBLIC_HOST ?= argocd.$(LUBAN_PUBLIC_DOMAIN)
HARBOR_HOST ?= harbor.$(K8S_DOMAIN)
HARBOR_PUBLIC_HOST ?= harbor.$(LUBAN_PUBLIC_DOMAIN)
JUPYTERHUB_HOST ?= jupyterhub.$(K8S_DOMAIN)
JUPYTERHUB_PUBLIC_HOST ?= jupyterhub.$(LUBAN_PUBLIC_DOMAIN)
KEYCLOAK_HOST ?= idp.$(APPS_DOMAIN)
KEYCLOAK_PUBLIC_HOST ?= idp.$(APPS_PUBLIC_DOMAIN)
KEYCLOAK_CANONICAL_HOST ?= $(KEYCLOAK_PUBLIC_HOST)
MINIO_HOST ?= minio-console.$(K8S_DOMAIN)
MINIO_PUBLIC_HOST ?= minio-console.$(LUBAN_PUBLIC_DOMAIN)
STARROCKS_HOST ?= starrocks.$(K8S_DOMAIN)
STARROCKS_PUBLIC_HOST ?= starrocks.$(LUBAN_PUBLIC_DOMAIN)

KIBANA_HOST ?= kibana.$(K8S_DOMAIN)
KIBANA_PUBLIC_HOST ?= kibana.$(LUBAN_PUBLIC_DOMAIN)
KIBANA_PUBLIC_BASE_URL ?= https://$(KIBANA_HOST)

APM_HOST ?= apm.$(K8S_DOMAIN)
APM_PUBLIC_HOST ?= apm.$(LUBAN_PUBLIC_DOMAIN)


# Optional mirror/proxy for ghcr.io.
# Default: unset (use ghcr.io directly).
#
# When to use:
# - If pulling from ghcr.io is slow/unstable in your network (commonly in Mainland China),
#   you can route requests via a mirror (example: ghcr.nju.edu.cn).
#
# Caveats:
# - Mirrors can be rate-limited, stale, or temporarily unavailable. If you see image pull errors,
#   unset GHCR_MIRROR and retry with ghcr.io.
#
# Example:
# GHCR_MIRROR ?= ghcr.nju.edu.cn

# Helm Configuration
# Use project-local Helm configuration to ensure hermetic builds and avoid global config issues.
mkfile_path := $(abspath $(lastword $(MAKEFILE_LIST)))
ROOT_DIR := $(dir $(mkfile_path))
export HELM_CACHE_HOME := $(ROOT_DIR).helm/cache
export HELM_CONFIG_HOME := $(ROOT_DIR).helm/config
export HELM_DATA_HOME := $(ROOT_DIR).helm/data
