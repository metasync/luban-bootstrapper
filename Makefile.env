KUBECTL ?= kubectl

# Shared versions, namespaces and hostnames for all Makefiles.
# Adjust these values to customize component versions and base domain.

# Argo Workflows: Chart 0.47.0 -> App 3.7.7
ARGO_WORKFLOWS_NAMESPACE ?= argo
ARGO_WORKFLOWS_CHART_VERSION ?= 0.47.0
# Argo CLI version usually matches the App version
ARGO_CLI_VERSION ?= 3.7.7

# Argo CD: Chart 9.3.4 -> App 3.2.5
ARGO_CD_NAMESPACE ?= argocd
ARGO_CD_CHART_VERSION ?= 9.3.4

# Argo Events: Chart 2.4.19 -> App 1.9.9
ARGO_EVENTS_NAMESPACE ?= argo-events
ARGO_EVENTS_CHART_VERSION ?= 2.4.19

# kpack: 0.17.1
KPACK_NAMESPACE ?= kpack
KPACK_VERSION ?= 0.17.1

# kp CLI: 0.13.1
KP_CLI_VERSION ?= 0.13.1

# pack CLI: 0.39.1
PACK_CLI_VERSION ?= 0.39.1

# Helm CLI: 4.0.5
HELM_CLI_VERSION ?= 4.0.5

# Kubectl CLI: 1.35.0
KUBECTL_CLI_VERSION ?= 1.35.0

# Envoy Gateway: Chart version matches App version (1.6.2)
ENVOY_GATEWAY_NAMESPACE ?= envoy-gateway-system
ENVOY_GATEWAY_CHART_VERSION ?= 1.6.2

# Cert Manager: Chart version matches App version (1.19.2)
CERT_MANAGER_NAMESPACE ?= cert-manager
CERT_MANAGER_CHART_VERSION ?= 1.19.2

# Harbor: Chart 1.18.0 -> App 2.14.0
HARBOR_NAMESPACE ?= harbor
HARBOR_CHART_VERSION ?= 1.18.0

# JupyterHub: Chart 4.3.2 -> App 5.4.3
JUPYTERHUB_NAMESPACE ?= jupyterhub
JUPYTERHUB_CHART_VERSION ?= 4.3.2

GATEWAY_NAMESPACE ?= gateway

# Hostnames for Web UIs
# Note: These defaults are for local development.
# Public URLs use *.luban.metasync.cc
K8S_DOMAIN ?= luban.k8s.orb.local
ARGO_WORKFLOWS_HOST ?= argo-workflows.$(K8S_DOMAIN)
ARGO_CD_HOST ?= argocd.$(K8S_DOMAIN)
HARBOR_HOST ?= harbor.$(K8S_DOMAIN)
JUPYTERHUB_HOST ?= jupyterhub.$(K8S_DOMAIN)

# Mirror for ghcr.io (e.g. ghcr.nju.edu.cn)
GHCR_MIRROR ?= ghcr.nju.edu.cn

# Helm Configuration
# Use project-local Helm configuration to ensure hermetic builds and avoid global config issues.
mkfile_path := $(abspath $(lastword $(MAKEFILE_LIST)))
ROOT_DIR := $(dir $(mkfile_path))
export HELM_CACHE_HOME := $(ROOT_DIR).helm/cache
export HELM_CONFIG_HOME := $(ROOT_DIR).helm/config
export HELM_DATA_HOME := $(ROOT_DIR).helm/data
