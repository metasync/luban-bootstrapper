KUBECTL ?= kubectl

# Shared versions, namespaces and hostnames for all Makefiles.
# Adjust these values to customize component versions and base domain.

ARGO_WORKFLOWS_NAMESPACE ?= argo
ARGO_WORKFLOWS_VERSION ?= 3.7.7

ARGO_CD_NAMESPACE ?= argocd
ARGO_CD_VERSION ?= 3.2.5

ARGO_EVENTS_NAMESPACE ?= argo-events
ARGO_EVENTS_VERSION ?= 1.9.9

KPACK_NAMESPACE ?= kpack
KPACK_VERSION ?= 0.17.1

ENVOY_GATEWAY_NAMESPACE ?= envoy-gateway-system
ENVOY_GATEWAY_VERSION ?= 1.6.2

CERT_MANAGER_NAMESPACE ?= cert-manager
CERT_MANAGER_VERSION ?= 1.19.2

GATEWAY_NAMESPACE ?= gateway

K8S_DOMAIN ?= k8s.orb.local

ARGO_WORKFLOWS_HOST ?= argo-workflows.$(K8S_DOMAIN)
ARGO_CD_HOST ?= argocd.$(K8S_DOMAIN)
